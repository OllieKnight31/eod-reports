# EOD System, environment variables.
# A reference list. You do not copy this file: scripts/configure.js writes client.env (read by
# the local preview, sent to Vercel by scripts/push-env.js), and most values can be entered on
# /settings instead. Anything left blank uses sensible defaults; missing values fail soft.

# ── Branding (cosmetic) ─────────────────────────────────────────────────────
# Shown on every page, form and channel post.
BRAND_NAME="Your Business"
BRAND_COLOR="#EF4444"
TIMEZONE="UTC"
CURRENCY_SYMBOL="$"   # revenue on the dashboards, closer form and closer notifications

# ── Sources segmented by the dashboard (comma-separated, order preserved) ──
LEAD_SOURCES="Webinar,DM,Lead Magnet,VSL,Community"

# ── Closer form ────────────────────────────────────────────────────────────
# Extra lead sources offered ONLY on the closer form (booking origins that aren't
# setter sources, e.g. a dialler working old leads). Segmented on the dashboard too.
CLOSER_EXTRA_SOURCES=""            # e.g. "Dialler, Old Leads"
# Who can be credited with booking a call, one optional field per role.
# "setter" (default) or "setter,dialler" for clients with a dialler.
CLOSER_BOOKED_BY="setter,dialler"

# ── Google Sheets (REQUIRED, this is the data store) ──────────────────────
SPREADSHEET_ID=""
# Stringified service account JSON. Generate at console.cloud.google.com → APIs
# → Credentials → Service Account → Keys → Create new (JSON). Then share the
# spreadsheet with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_KEY=""
# Optional tab-name overrides
# SHEET_TAB_CLOSER="CLOSER OUTCOMES"
# SHEET_TAB_SETTER="SETTER ACTIVITY"

# ── Notifications, Discord and/or Slack per channel ──────────────────────
# Each is independently optional. Set neither, either, or both. Leave blank
# to disable that channel/provider combination.

# Discord webhooks: server settings → Integrations → Webhooks → New
DISCORD_SETTER_WEBHOOK=""
DISCORD_CLOSER_WEBHOOK=""

# Slack incoming webhooks: api.slack.com/apps → create app → Incoming Webhooks
# → Activate → Add New Webhook to Workspace → pick channel → copy URL
SLACK_SETTER_WEBHOOK=""
SLACK_CLOSER_WEBHOOK=""

# ── CRM (optional, drives the live pipeline section) ──────────────────────
# Supported: ghl | close | none
CRM_PROVIDER="none"

# Close (read-only pipeline). Required only if CRM_PROVIDER=close
# CLOSE_API_KEY=""          # api_…
# CLOSE_PIPELINE_ID=""
# CLOSE_STAGES_JSON=''      # {"callBooked":"stat_…","closedWon":"stat_…", …}, Close status ids

# Required only if CRM_PROVIDER=ghl
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_PIPELINE_ID=""
# Map closer-relevant stage keys → GHL stage UUIDs. Get IDs from GHL Settings →
# Pipelines → click pipeline → look at the URL of each stage. Paste as a single
# JSON object string.
GHL_STAGES_JSON='{"callBooked":"","callCompleted":"","proposalSent":"","closedWon":"","closedLost":"","noShow":""}'

# Optional: override stage order (left → right in the kanban)
# CLOSER_STAGE_ORDER="callBooked,callCompleted,proposalSent,closedWon,closedLost,noShow"
# Optional: override stage labels
# CLOSER_STAGE_LABELS_JSON='{"callBooked":"Booked","closedWon":"Won"}'

# ── Dialler report (/dialler-eod) ────────────────────────────────────────────
# On when REPORT_ROLES includes dialler. Only name + date are required; a KPI with nothing to measure (no new leads,
# no calls due) is marked "n/a" and counts as neither a hit nor a miss.
# SHEET_TAB_DIALLER="DIALLER ACTIVITY"
DISCORD_DIALLER_WEBHOOK=""
SLACK_DIALLER_WEBHOOK=""
KPI_DIALS="300"
KPI_CONVERSATIONS="20"
KPI_SPEED_TO_LEAD_MIN="5"
KPI_SET_SHOW_RATE="60"
KPI_TRIAGED_SHOW_RATE="80"

# ── Setter and closer daily targets (the bars on /scorecard). 0 = no target ──
KPI_SETTER_MESSAGES="50"
KPI_SETTER_OUTBOUNDS="30"
KPI_SETTER_FOLLOWUPS="20"
KPI_SETTER_CALLS_BOOKED="3"
KPI_CLOSER_CALLS="5"
KPI_CLOSER_SHOW_RATE="70"
KPI_CLOSER_CLOSE_RATE="25"
KPI_CLOSER_REVENUE="0"

# ── Zero-call closer days ────────────────────────────────────────────────────
# A closer who took no calls picks "No, zero calls today"; it is logged here, never
# in CLOSER OUTCOMES (every row there is read as a call).
# SHEET_TAB_CLOSER_NO_CALLS="CLOSER NO-CALL DAYS"

# ── Roster (name dropdowns + reminders) ──────────────────────────────────────
# Names per role. A role with entries gets a dropdown instead of a free-text name box.
# slack / discord = member IDs the reminder @mentions. nudge:false = listed, never chased.
ROSTER_JSON=''            # '{"dialler":[{"name":"Jo Lee","slack":"U01ABC2345"}],"setter":["Sam Jones"],"closer":["Charlie Reed"]}'

# ── Which reports this business uses ────────────────────────────────────────
# Leave a role out and its report tab, channel, scorecard section and reminders disappear.
REPORT_ROLES="setter,dialler,closer"

# ── Slack / Discord, bot token route (alternative to the *_WEBHOOK URLs) ─────
# One token per provider, then a channel ID per destination. On /settings the
# channels are picked from a list instead of typed.
SLACK_BOT_TOKEN=""              # xoxb-…  scopes: chat:write, chat:write.public, channels:read, groups:read
SLACK_SETTER_CHANNEL=""         # C01ABCD2345
SLACK_DIALLER_CHANNEL=""
SLACK_CLOSER_CHANNEL=""
SLACK_SCORECARD_CHANNEL=""
DISCORD_BOT_TOKEN=""
DISCORD_SETTER_CHANNEL=""       # channel ID (a long number)
DISCORD_DIALLER_CHANNEL=""
DISCORD_CLOSER_CHANNEL=""
DISCORD_SCORECARD_CHANNEL=""
# Webhook route for the scorecard channel (the per-role webhooks are above)
DISCORD_SCORECARD_WEBHOOK=""
SLACK_SCORECARD_WEBHOOK=""

# ── Scheduled jobs: missed-report reminders + daily scorecard post ──────────
# scripts/configure.js (or scripts/set-cron.js) writes a schedule into vercel.json that
# checks in every hour; the values below decide what runs when, and can be changed on
# /settings without a redeploy.
CRON_SECRET=""            # MUST be an env var, Vercel sends it with each cron call
REMINDERS="on"            # "off" to stop chasing
NUDGE_HOUR="21"           # local hour, in TIMEZONE
NUDGE_DAYS="1,2,3,4,5"    # 0 = Sunday. Per role: NUDGE_DAYS_DIALLER="0,1,2,3,4,5,6"
NUDGE_ROLES=""            # blank = every role in use
SCORECARD_POST="on"       # "off" to stop the daily post
SCORECARD_HOUR="8"        # local hour. Before noon it recaps yesterday; from noon, today.

# ── Logins and the settings page ────────────────────────────────────────────
# Every page needs a login. On the first visit the owner creates their account using the
# SETUP CODE below; they then add logins for managers, setters, diallers and closers under
# Settings → Logins. Everything else in this file can be entered by the owner on /settings
# instead (saved values are encrypted and override these env vars).
ADMIN_PASSWORD=""            # the SETUP CODE. Also signs sessions and encrypts saved settings.
#                            # Generated by scripts/configure.js. It also resets the owner login
#                            # if it is ever lost (POST /api?source=auth_setup).
# SETTINGS_SECRET=""         # optional separate signing/encryption secret, set it if you ever
#                            # want to change the setup code without logging everyone out
# Storage for logins and saved settings: attach Upstash Redis in Vercel (Storage → Upstash)
# and these two are injected automatically. Local dev uses the gitignored .data/ folder.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# PUBLIC_URL=""             # the address links in channel posts use, e.g. a custom domain. Unset =
#                            # the Vercel production address (never the locked per-deployment one)
# INBOUND_KEY=""             # only for outside forms (GHL, Tally…) posting reports: they send
#                            # "Authorization: Bearer <this>". Unset = outside forms are off.
